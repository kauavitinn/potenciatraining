{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/loja",
      "permanent": true
    },
    {
      "source": "/curso.html",
      "destination": "/curso",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/curso.html"
    },
    {
      "source": "/loja",
      "destination": "/index.html"
    },
    {
      "source": "/curso",
      "destination": "/curso.html"
    }
  ]
}
